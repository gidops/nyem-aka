# Copy to .env and adjust. .env is never committed.

# Runtime connection used by the API. On Neon this is the POOLED connection string.
DATABASE_URL="postgresql://nyemaka:nyemaka@localhost:5433/nyemaka"

# Connection used by the Prisma CLI (migrate, seed, studio). On Neon this is the DIRECT string.
# Locally both point at the same Docker database.
DIRECT_URL="postgresql://nyemaka:nyemaka@localhost:5433/nyemaka"

# First administrator, created by `npx prisma db seed`.
SEED_ADMIN_EMAIL="admin@nyemaka.local"
SEED_ADMIN_PASSWORD="change-me-before-seeding"
SEED_ADMIN_NAME="System Administrator"

PORT=4000

# Auth. Two different secrets so an access token can never be replayed as a refresh token.
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# How many proxies sit in front of the API (see src/app.setup.ts). 1 locally.
TRUST_PROXY_HOPS=1

# Image storage. Leave empty in development: uploads then go to apps/api/uploads.
# Required in production (the API refuses to start without them).
# Verify them with: npm run check:cloudinary -w api
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
