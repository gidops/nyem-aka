# Copy to .env and adjust. .env is never committed.

# Runtime connection used by the API. On Neon this is the POOLED connection string.
DATABASE_URL="postgresql://nyemaka:nyemaka@localhost:5433/nyemaka"

# Connection used by the Prisma CLI (migrate, seed, studio). On Neon this is the DIRECT string.
# Locally both point at the same Docker database.
DIRECT_URL="postgresql://nyemaka:nyemaka@localhost:5433/nyemaka"

# First administrator, created by `npx prisma db seed`.
SEED_ADMIN_EMAIL="admin@nyemaka.local"
SEED_ADMIN_PASSWORD="change-me-before-seeding"
SEED_ADMIN_NAME="System Administrator"

PORT=4000
